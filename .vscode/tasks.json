{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run TourIraq frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"TourIraq/frontend",
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run TourIraq API",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"TourIraq/backend/TourIraq.Api/TourIraq.Api.csproj"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Check admin API contract",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"TourIraq/backend/TourIraq.Api/TourIraq.Api.csproj",
				"--no-restore",
				"--configuration",
				"Release"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Build admin API endpoints",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"TourIraq/backend/TourIraq.Api/TourIraq.Api.csproj",
				"--no-restore",
				"--configuration",
				"Release"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Add single admin index migration",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"ef",
				"migrations",
				"add",
				"LimitToOneAdmin",
				"--project",
				"TourIraq/backend/TourIraq.Api/TourIraq.Api.csproj",
				"--startup-project",
				"TourIraq/backend/TourIraq.Api/TourIraq.Api.csproj",
				"--configuration",
				"Release"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Build admin navigation",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"TourIraq/frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}